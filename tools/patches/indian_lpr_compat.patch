-from src.License_Plate_Recognition.test_LPRNet import Greedy_Decode_inference
@@ -19,0 +19,32 @@ from tqdm import tqdm
+CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ-"
+
+
+def Greedy_Decode_inference(net, images):
+    """Decode the LPRNet output without importing training-only dependencies."""
+    if torch.cuda.is_available():
+        images = images.cuda()
+
+    predictions = net(images).cpu().detach().numpy()
+    labels = []
+    blank = len(CHARS) - 1
+
+    for prediction in predictions:
+        raw_label = np.argmax(prediction, axis=0)
+        decoded = []
+        previous = raw_label[0]
+        if previous != blank:
+            decoded.append(previous)
+
+        for character in raw_label:
+            if character == previous or character == blank:
+                if character == blank:
+                    previous = character
+                continue
+            decoded.append(character)
+            previous = character
+
+        labels.append("".join(CHARS[index] for index in decoded))
+
+    return labels
+
+
