# Optional. The default local worker URL is http://127.0.0.1:8770.
VITE_OPTIVISION_WORKER_URL=http://127.0.0.1:8770

# Optional runtime tuning. Defaults are safe for a local CPU/GPU demo.
VITE_OPTIVISION_REQUEST_TIMEOUT_MS=15000
VITE_OPTIVISION_ANALYSIS_INTERVAL_MS=500
VITE_OPTIVISION_MAX_CONCURRENT_ANALYSES=2
